<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The BASE_URL and REPO_SUBDIR placeholders below are filled in by tools/build_repo.py from tools/config.json -->
<addon id="repository.tonyflix" name="TonyFlix Repository" version="1.0.0" provider-name="TonyFlix">
    <extension point="xbmc.addon.repository" name="TonyFlix Repository">
        <dir>
            <info compressed="false">{BASE_URL}/{REPO_SUBDIR}/addons.xml</info>
            <checksum>{BASE_URL}/{REPO_SUBDIR}/addons.xml.md5</checksum>
            <datadir zip="true">{BASE_URL}/{REPO_SUBDIR}/zips/</datadir>
            <hashes>sha256</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">TonyFlix build repository</summary>
        <description lang="en_GB">Hosts the TonyFlix skin, wizard and maintenance service. Third-party add-ons are installed from their own official repositories.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
