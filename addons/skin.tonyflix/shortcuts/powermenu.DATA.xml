<?xml version='1.0' encoding='UTF-8'?>
<!-- TonyFlix power menu (the power icon at the top of Home).
     Exit / Force close run through the TonyFlix Wizard on purpose: Skin Shortcuts hides a plain Quit()
     item unless System.ShowExitButton is true, which it isn't on every box. -->
<shortcuts>
    <shortcut>
        <icon>special://skin/extras/icons/circle-user.png</icon>
        <label>Accounts</label>
        <label2>Power Shortcut</label2>
        <action>RunScript(plugin.program.tonyflix.wizard,accounts)</action>
    </shortcut>
    <shortcut>
        <icon>special://skin/extras/icons/sliders.png</icon>
        <label>TonyFlix</label>
        <label2>Power Shortcut</label2>
        <action>RunScript(plugin.program.tonyflix.wizard,menu)</action>
    </shortcut>
    <shortcut>
        <icon>special://skin/extras/icons/settings.png</icon>
        <label>$LOCALIZE[5]</label>
        <label2>Power Shortcut</label2>
        <action>ActivateWindow(interfacesettings)</action>
    </shortcut>
    <shortcut>
        <icon>special://skin/extras/icons/addon.png</icon>
        <label>$LOCALIZE[24001]</label>
        <label2>Power Shortcut</label2>
        <action>ActivateWindow(addonbrowser)</action>
    </shortcut>
    <shortcut>
        <icon>special://skin/extras/icons/power.png</icon>
        <label>Exit Kodi</label>
        <label2>Power Shortcut</label2>
        <action>RunScript(plugin.program.tonyflix.wizard,exit)</action>
    </shortcut>
    <shortcut>
        <icon>special://skin/extras/icons/xmark.png</icon>
        <label>Force close</label>
        <label2>Power Shortcut</label2>
        <action>RunScript(plugin.program.tonyflix.wizard,forceclose)</action>
    </shortcut>
</shortcuts>
