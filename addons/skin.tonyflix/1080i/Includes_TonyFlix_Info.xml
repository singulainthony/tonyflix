<?xml version="1.0" encoding="UTF-8"?>
<!-- TonyFlix: info-screen ("recommendations") request list, gated by skin settings.

     AH2 passed TMDbHelper one fixed list of ~15 lookups for every info screen
     (cast, collection, recommendations, similar, posters, fanart, Trakt comments,
     keywords, crew, Trakt lists, year, genre, studio, director, writer) - the
     Info.Disable* settings only hid rows AFTER their data was fetched. Here every
     segment is only requested when its row is enabled, so disabled rows cost
     nothing. TonyFlix defaults (Custom_1198_Startup.xml, v4) disable the
     expensive/rarely-used ones.

     Format consumed by TMDbHelper: "id|path|is_tmdbhelper|action" items joined by "||".
     Cast (5000) is always first and always on, so every other segment starts with "||". -->
<includes>
    <variable name="TF_Recs_Movie">
        <value>5000|info=cast$VAR[Path_Param_AggregateCast]|true|info$VAR[TF_Recs_Collection]$VAR[TF_Recs_Recommendations]$VAR[TF_Recs_Similar]$VAR[TF_Recs_Posters]$VAR[TF_Recs_Fanart]$VAR[TF_Recs_Comments]$VAR[TF_Recs_MovieKeywords]$VAR[TF_Recs_Crew]$VAR[TF_Recs_InLists]$VAR[TF_Recs_Year]$VAR[TF_Recs_Genre]$VAR[TF_Recs_Studio]$VAR[TF_Recs_Director]$VAR[TF_Recs_Writer]</value>
    </variable>
    <variable name="TF_Recs_TV">
        <value>5000|info=cast$VAR[Path_Param_AggregateCast]|true|info$VAR[TF_Recs_Season]$VAR[TF_Recs_Recommendations]$VAR[TF_Recs_Similar]$VAR[TF_Recs_Posters]$VAR[TF_Recs_Fanart]$VAR[TF_Recs_Comments]$VAR[TF_Recs_Crew]$VAR[TF_Recs_UpNext]$VAR[TF_Recs_InLists]$VAR[TF_Recs_Year]$VAR[TF_Recs_Genre]$VAR[TF_Recs_Studio]$VAR[TF_Recs_Director]$VAR[TF_Recs_Writer]</value>
    </variable>

    <variable name="TF_Recs_Collection">
        <value condition="!Skin.HasSetting(Info.DisableCollections)">$VAR[Path_Recs_Collection,||5002|,|false|info]</value>
    </variable>
    <variable name="TF_Recs_Season">
        <value condition="!Skin.HasSetting(Info.DisableSeasons)">$VAR[Path_Recs_Season,||5001|,|true|browse]</value>
    </variable>
    <variable name="TF_Recs_Recommendations">
        <value condition="!Skin.HasSetting(Info.DisableRecommendations)">||5003|info=recommendations|true|info</value>
    </variable>
    <variable name="TF_Recs_Similar">
        <value condition="!Skin.HasSetting(Info.DisableSimilar)">||5004|info=similar|true|info</value>
    </variable>
    <variable name="TF_Recs_Posters">
        <value condition="!Skin.HasSetting(Info.DisablePosters)">||5091|info=posters|true|SetFocus(5291)</value>
    </variable>
    <variable name="TF_Recs_Fanart">
        <value condition="!Skin.HasSetting(Info.DisableFanart)">||5092|info=fanart|true|SetFocus(5292)</value>
    </variable>
    <variable name="TF_Recs_Comments">
        <value condition="!Skin.HasSetting(Info.DisableReviews) + [!String.IsEmpty(Window(Home).Property(TMDbHelper.TraktIsAuth)) | Skin.HasSetting(TonyFlix.TraktLinked)]">||5093|info=trakt_comments|true|text</value>
    </variable>
    <variable name="TF_Recs_MovieKeywords">
        <value condition="!Skin.HasSetting(Info.DisableKeywords)">||5094|info=movie_keywords|true|SetFocus(5095,0,absolute)</value>
    </variable>
    <variable name="TF_Recs_Crew">
        <value condition="!Skin.HasSetting(Info.DisableCrew)">||5010|info=crew$VAR[Path_Param_AggregateCrew]|true|info</value>
    </variable>
    <!-- Trakt calls without a linked account pop a blocking login dialog -->
    <variable name="TF_Recs_UpNext">
        <value condition="!Skin.HasSetting(Info.DisableUpNext) + [!String.IsEmpty(Window(Home).Property(TMDbHelper.TraktIsAuth)) | Skin.HasSetting(TonyFlix.TraktLinked)]">$VAR[Path_Recs_UpNext,||5011|,|true|play]</value>
    </variable>
    <variable name="TF_Recs_InLists">
        <value condition="!Skin.HasSetting(Info.DisableTraktLists) + [!String.IsEmpty(Window(Home).Property(TMDbHelper.TraktIsAuth)) | Skin.HasSetting(TonyFlix.TraktLinked)]">||5030|info=trakt_inlists|true|browse</value>
    </variable>
    <variable name="TF_Recs_Year">
        <value condition="!Skin.HasSetting(Info.DisableYear)">$VAR[Path_Recs_Year,||5005|,|false|info]</value>
    </variable>
    <variable name="TF_Recs_Genre">
        <value condition="!Skin.HasSetting(Info.DisableGenre)">$VAR[Path_Recs_Genre,||5006|,|false|info]</value>
    </variable>
    <variable name="TF_Recs_Studio">
        <value condition="!Skin.HasSetting(Info.DisableStudio)">$VAR[Path_Recs_Studio,||5007|,|false|info]</value>
    </variable>
    <variable name="TF_Recs_Director">
        <value condition="!Skin.HasSetting(Info.DisableDirector)">$VAR[Path_Recs_Director,||5008|,|false|info]</value>
    </variable>
    <variable name="TF_Recs_Writer">
        <value condition="!Skin.HasSetting(Info.DisableWriter)">$VAR[Path_Recs_Writer,||5009|,|false|info]</value>
    </variable>

    <!-- "Play with..." button (Items_DialogVideoInfo_MenuBar): TMDbHelper play script with the
         default player bypassed, so the player chooser opens. Episodes need the SHOW's tmdb id. -->
    <expression name="TF_PlayWith_Available">[String.IsEqual(ListItem.DBType,movie) + !String.IsEmpty(ListItem.UniqueID(tmdb))] | [String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.UniqueID(tvshow.tmdb))]</expression>
    <variable name="TF_PlayWith_Params">
        <value condition="String.IsEqual(ListItem.DBType,movie) + !String.IsEmpty(ListItem.UniqueID(tmdb))">play=movie,tmdb_id=$INFO[ListItem.UniqueID(tmdb)]</value>
        <value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.UniqueID(tvshow.tmdb))">play=tv,tmdb_id=$INFO[ListItem.UniqueID(tvshow.tmdb)],season=$INFO[ListItem.Season],episode=$INFO[ListItem.Episode]</value>
    </variable>
</includes>
