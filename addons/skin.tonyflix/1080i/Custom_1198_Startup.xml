<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1198">
    <onload>AlarmClock(RepWin,SetFocus(9002),00:01,silent)</onload>
    <onload condition="String.IsEmpty(Window.Property(ReloadDone))">SetProperty(InitStatus,$LOCALIZE[31145])</onload>

    <!-- Set default settings -->
    <onload condition="String.IsEmpty(Skin.String(BackgroundStyle))">Skin.SetString(BackgroundStyle,Fanart)</onload>
    <onload condition="String.IsEmpty(Skin.String(ForegroundStyle))">Skin.SetString(ForegroundStyle,None)</onload>

    <!-- TonyFlix low-power defaults. Applied once per defaults version, so anything the
         user turns back on in Skin Settings afterwards is respected. Bump the version
         number (all lines) to re-apply after changing this list. -->
    <!-- Background video and extra-fanart slideshows: constant decode/texture churn -->
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.Reset(UseBackgroundVideo)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.Reset(Background.ExtraFanart)</onload>
    <!-- TMDbHelper image processing runs in Python (PIL) on every focus change -->
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.Reset(TMDbHelper.EnableBlur)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.Reset(TMDbHelper.EnableCrop)</onload>
    <!-- No Live TV in TonyFlix: skip PVR lookups in the TMDbHelper service -->
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(TMDbHelper.DisablePVR)</onload>
    <!-- v2: Netflix-style look (backdrop of the focused title top-right, info on the left) -->
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetString(ForegroundStyle,FlixArt)</onload>
    <!-- v3: always open on the Home tab (menu index 0) instead of the last-focused tab -->
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetString(Home.MenuPosition,0)</onload>
    <!-- v4: info screens only fetch Cast, Collection/Seasons, More Like This, Similar, Keywords, Director, Up Next.
         Each disabled row is no longer requested at all (Includes_TonyFlix_Info.xml). -->
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisablePosters)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableFanart)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableReviews)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableCrew)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableTraktLists)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableYear)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableGenre)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableStudio)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableWriter)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetBool(Info.DisableYoutube)</onload>
    <onload condition="!String.IsEqual(Skin.String(TonyFlix.DefaultsVersion),4)">Skin.SetString(TonyFlix.DefaultsVersion,4)</onload>

    <!-- Start TMDbH service -->
    <onload condition="String.IsEmpty(Window.Property(ReloadDone))">Skin.SetBool(TMDbHelper.Service)</onload>
    <onload condition="String.IsEmpty(Window.Property(ReloadDone))">Skin.SetBool(TMDbHelper.UseLocalWidgetContainer)</onload>
    <onload condition="String.IsEmpty(Window.Property(ReloadDone))">Skin.SetString(TMDbHelper.MonitorContainer,99950)</onload>

    <!-- Build includes for textures / views / menus -->
    <include condition="String.IsEmpty(Window.Property(ReloadDone))">Action_BuildTextures_Onload</include>
    <onload condition="String.IsEmpty(Window.Property(ReloadDone))">RunScript(script.skinvariables,action=buildviews)</onload>
    <onload condition="!String.IsEmpty(Window.Property(ReloadDone))">SetProperty(InitStatus,$LOCALIZE[31248])</onload>
    <onload>SetProperty(ReloadDone,1)</onload>
    <onload>SetProperty(ReloadDone,1,Home)</onload>

    <controls>
        <include content="Object_Hidden_List" condition="Skin.HasSetting(Startup.PluginInit)">
            <param name="id">8000</param>
            <content>plugin://plugin.video.themoviedb.helper/?info=popular&amp;tmdb_type=movie</content>
        </include>
        <control type="button" id="9001">
            <texturefocus />
            <texturenofocus />
            <onfocus condition="[System.HasPVRAddon + !PVR.HasTVChannels + !Pvr.HasRadioChannels]">SetProperty(InitStatus,$LOCALIZE[31249])</onfocus>
            <onfocus condition="![System.HasPVRAddon + !PVR.HasTVChannels + !Pvr.HasRadioChannels]">SetProperty(InitStatus,$LOCALIZE[31358])</onfocus>
            <onfocus>AlarmClock(RepWin,SetFocus(9002),00:01,silent)</onfocus>
        </control>
        <control type="button" id="9002">
            <texturefocus />
            <texturenofocus />
            <onfocus condition="[System.HasPVRAddon + !PVR.HasTVChannels + !Pvr.HasRadioChannels] | [Skin.HasSetting(Startup.PluginInit) + Container(8000).IsUpdating]">AlarmClock(ReFocus,SetFocus(9001),00:00,silent)</onfocus>
            <onfocus>AlarmClock(RepWin,ReplaceWindow($INFO[System.StartupWindow]),00:01,silent)</onfocus>
        </control>
        <control type="group">
            <include>Background_StartUp</include>
            <include>Object_StartUp_Logo</include>
            <control type="label">
                <centertop>610</centertop>
                <height>40</height>
                <aligny>center</aligny>
                <align>center</align>
                <textcolor>main_logo</textcolor>
                <label>$INFO[Window.Property(InitStatus)]...</label>
            </control>
            <control type="group">
                <centertop>700</centertop>
                <height>80</height>
                <include content="Object_BusySpinner">
                    <param name="colordiffuse" value="main_fg" />
                    <param name="haslabel" value="false" />
                </include>
            </control>
        </control>

        <include>Furniture_Top_Right</include>
    </controls>
</window>